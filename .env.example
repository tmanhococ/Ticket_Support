# ============================================================
# .env.example — Copy to .env and fill in real values
# .env is gitignored and must NEVER be committed to the repo
# ============================================================

# PostgreSQL
POSTGRES_USER=tickets_user
POSTGRES_PASSWORD=tickets_pass
POSTGRES_DB=tickets_db

# FastAPI
# Used by the api container to connect to the db container
DATABASE_URL=postgresql+asyncpg://tickets_user:tickets_pass@db:5432/tickets_db

# Simulator
# Internal Docker network hostname for the API service
API_URL=http://api:8000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your_bucket_name_here

# MLflow Tracking (Epic 7)
# Use http://localhost:5000 when running training script locally (outside Docker)
# Use http://mlflow:5000 when running inside Docker containers (Docker-internal hostname)
MLFLOW_TRACKING_URI=http://localhost:5000
# Optional: only needed for MinIO/local S3 alternative. Leave blank for real AWS S3.
MLFLOW_S3_ENDPOINT_URL=

# Drift Monitor (Epic 9)
# Time window to consider "current" production data (hours)
CURRENT_WINDOW_HOURS=24
# Number of oldest tickets to use as reference baseline
REFERENCE_SAMPLE_SIZE=500
# How often to run the drift job in scheduled mode (hours)
SCHEDULE_INTERVAL_HOURS=6
