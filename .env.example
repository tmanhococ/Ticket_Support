# ============================================================
# .env.example — Copy to .env and fill in real values
# .env is gitignored and must NEVER be committed to the repo
# ============================================================

# PostgreSQL
POSTGRES_USER=tickets_user
POSTGRES_PASSWORD=tickets_pass
POSTGRES_DB=tickets_db

# FastAPI
# Used by the api container to connect to the db container
DATABASE_URL=postgresql+asyncpg://tickets_user:tickets_pass@db:5432/tickets_db

# Simulator
# Internal Docker network hostname for the API service
API_URL=http://api:8000
